aws_region          = "ap-southeast-1"
project_name        = "iris-mlops"
environment         = "prod"
kubernetes_version  = "1.33"
az_count             = 2
node_instance_types  = ["t3.medium"]
node_min_size        = 3
node_desired_size    = 3
node_max_size        = 4
db_instance_class   = "db.t4g.micro"
db_multi_az          = true

# Add only secret ARNs after creating the corresponding Secrets Manager entries.
# Values remain in Secrets Manager and are never stored in Terraform state.
additional_external_secret_arns = []

# One NAT keeps GitHub/public registry egress. S3 uses its free gateway endpoint.
enable_nat_gateway             = true
single_nat_gateway             = true
enable_interface_vpc_endpoints = false
admin_role_arns                = ["arn:aws:iam::123456789012:role/YourAdminRole"]

# Enable only after terraform/domain has created the zone, the registrar has
# delegated its name servers, and ACM validation has completed.
enable_public_domain = false
kserve_subdomain     = "api"

# CI supplies these bootstrap outputs through TF_VAR_* environment variables.
# state_bucket_name = "globally-unique-terraform-state-bucket"
# state_kms_key_arn = "arn:aws:kms:ap-southeast-1:123456789012:key/..."
