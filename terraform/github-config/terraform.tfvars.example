github_owner             = "chiendz11"
enable_public_domain     = true
public_domain_name       = "example.com"
admin_role_arns          = ["arn:aws:iam::123456789012:role/eks-admin"]
manage_application_config = true
# Solo profile: github_owner self-approves deployments; no collaborator or extra reviewer input.
inference_publisher_app_client_id = "Iv23liINFERENCE"
model_registry_publisher_app_client_id = "Iv23liREGISTRY"
platform_contract_publisher_actor = "iris-platform-contract-publisher[bot]"
inference_publisher_actor = "iris-inference-publisher[bot]"
model_registry_publisher_actor = "iris-model-registry-publisher[bot]"
model_release_publisher_actor = "iris-model-release-publisher[bot]"

# State bucket/KMS inputs are normally supplied by CI as TF_VAR_* variables.
# GitHub authentication is supplied only as a short-lived GITHUB_TOKEN.
